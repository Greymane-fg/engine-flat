{
  "name": "engine-flat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Shopify Store Readiness & Growth Platform \u2014 a single-page readiness assessment and service marketplace.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "smoke": "vite-node scripts/smoke.tsx",
    "test:email": "vite-node scripts/email-test.tsx",
    "test": "vite-node scripts/smoke.tsx && vite-node scripts/email-test.tsx"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "lucide-react": "^1.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0"
  }
}
