# ---------------------------------------------------------------------------
# EmailJS — application + assessment notifications
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the five values.
# The EmailJS PUBLIC key is safe to ship in a browser bundle; never put a
# PRIVATE key or SMTP password in a VITE_ variable.
#
# Dashboard: https://dashboard.emailjs.com
#   Account → General            → Public Key
#   Email Services → your service → Service ID
#   Email Templates → your two templates → Template ID

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx

# Template 1 — goes to YOU (the team inbox), full internal detail.
VITE_EMAILJS_ADMIN_TEMPLATE_ID=template_xxxxxxx

# Template 2 — goes to THE MERCHANT (confirmation + reference number).
VITE_EMAILJS_USER_TEMPLATE_ID=template_yyyyyyy

# Where the internal notification is delivered. Leave blank to use the
# address defined in src/config.ts.
VITE_EMAILJS_ADMIN_EMAIL=
