# ---------------------------------------------------------------------------
# EmailJS — optional overrides
# ---------------------------------------------------------------------------
# The deployment's service, public key and both template IDs are already set as
# defaults in src/lib/email.ts, so the app sends email without a .env file.
#
# Create this file only if you need to override or rotate them. Any value set
# here wins over the built-in default.
#
# The PUBLIC key is safe to ship in a browser bundle. Never put a PRIVATE key
# or SMTP password in a VITE_ variable — they are compiled into public JS.

# VITE_EMAILJS_SERVICE_ID=service_engine
# VITE_EMAILJS_PUBLIC_KEY=QW0apJtjNMp6E4PP9

# Template 1 — goes to YOU (the team inbox), full internal detail.
# VITE_EMAILJS_ADMIN_TEMPLATE_ID=template_2awtneq

# Template 2 — goes to THE MERCHANT (confirmation + reference number).
# VITE_EMAILJS_USER_TEMPLATE_ID=template_mrb3g7f

# Where the internal notification is delivered. Defaults to src/config.ts.
# VITE_EMAILJS_ADMIN_EMAIL=
